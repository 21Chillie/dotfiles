// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"session": {
  
 },
 "ssh_connections": [
  {
   "host": "chillie-server",
   "args": [],
   "projects": [
    {
     "paths": [
      "/srv"
     ]
    }
   ]
  }
 ],
 "completions": {
		"lsp": true
	},
	"show_wrap_guides": true,
	"rounded_selection": true,
	"hide_mouse": "on_typing_and_action",
	"text_rendering_mode": "platform_default",
	"use_on_type_format": true,
	"format_on_save": "on",
	"lsp_highlight_debounce": 75,
	"document_symbols": "off",
	"language_models": {
		"lmstudio": {
			"api_url": "http://127.0.0.1:2121/api/v0",
			"api_key": "key"
		},
		"openai_compatible": {}
	},
	"cli_default_open_behavior": "existing_window",
	"hover_popover_enabled": true,
	"proxy": "",
	"git": {
		"inline_blame": {
			"show_commit_summary": true,
			"padding": 4
		}
	},
	"collaboration_panel": {
		"button": false
	},
	"outline_panel": {
		"indent_size": 16.0,
		"default_width": 220.0,
		"dock": "left",
		"button": true
	},
	"project_panel": {
		"hide_hidden": false,
		"hide_root": false,
		"indent_guides": {
			"show": "always"
		},
		"git_status_indicator": true,
		"diagnostic_badges": true,
		"show_diagnostics": "errors",
		"bold_folder_labels": false,
		"indent_size": 12.0,
		"entry_spacing": "standard",
		"default_width": 220.0
	},
	"bottom_dock_layout": "contained",
	"tab_bar": {
		"show_pinned_tabs_in_separate_row": false,
		"show": true
	},
	"title_bar": {
		"button_layout": "platform_default",
		"show_menus": false,
		"show_branch_status_icon": true
	},
	"status_bar": {
		"active_language_button": true,
		"show_active_file": false,
		"line_endings_button": true,
		"active_encoding_button": "non_utf8"
	},
	"close_on_file_delete": true,
	"search": {
		"include_ignored": false
	},
	"prettier": {
		"allowed": false
	},
	"diagnostics": {
		"lsp_pull_diagnostics": {
			"enabled": true
		},
		"inline": {
			"enabled": true,
			"update_debounce_ms": 150
		}
	},
	"colorize_brackets": true,
	"inlay_hints": {
		"show_value_hints": true,
		"show_type_hints": true,
		"show_background": false,
		"enabled": false
	},
	"edit_predictions": {
		"provider": "zed",
		"open_ai_compatible_api": {
			"model": "",
			"api_url": "",
			"prompt_format": "infer"
		},
		"allow_data_collection": "no",
		"mode": "subtle"
	},
	"always_treat_brackets_as_autoclosed": true,
	"indent_guides": {
		"background_coloring": "disabled",
		"line_width": 1
	},
	"auto_indent": "syntax_aware",
	"hard_tabs": false,
	"toolbar": {
		"code_actions": true,
		"selections_menu": true,
		"quick_actions": false,
		"breadcrumbs": false
	},
	"git_panel": {
		"dock": "left",
		"collapse_untracked_diff": false,
		"folder_icons": false,
		"diff_stats": true,
		"show_count_badge": true,
		"file_icons": false,
		"default_width": 280.0,
		"tree_view": true
	},
	"scrollbar": {
		"axes": {
			"horizontal": false
		},
		"cursors": true,
		"show": "auto"
	},
	"auto_signature_help": false,
	"which_key": {
		"enabled": false
	},
	"agent": {
		"thinking_display": "always_collapsed",
		"default_profile": "ask",
		"show_turn_stats": true,
		"play_sound_when_agent_done": "when_hidden",
		"single_file_review": true,
		"flexible": true,
		"default_width": 320.0,
		"default_model": {
			"provider": "lmstudio",
			"model": "qwopus3.5-9b-coder-mtp",
			"enable_thinking": false
		},
		"favorite_models": [],
		"model_parameters": []
	},
	"ui_font_weight": 400.0,
	"ui_font_family": "Satoshi",
	"buffer_font_weight": 400.0,
	"icon_theme": "Material Icon Theme",
	"auto_update": false,
	"terminal": {
		"toolbar": {
			"breadcrumbs": false
		},
		"default_height": 240.0,
		"font_size": 13.0,
		"working_directory": "current_project_directory",
		"show_count_badge": true,
		"cursor_shape": "underline",
		"blinking": "on"
	},
	"tabs": {
		"show_close_button": "hover",
		"show_diagnostics": "errors",
		"file_icons": true,
		"git_status": true,
		"close_position": "right"
	},
	"multi_cursor_modifier": "cmd_or_ctrl",
	"sticky_scroll": {
		"enabled": true
	},
	"gutter": {
		"breakpoints": true,
		"runnables": true,
		"line_numbers": true
	},
	"minimap": {
		"show": "never"
	},
	"hover_popover_sticky": true,
	"cursor_blink": true,
	"max_tabs": 5,
	"use_system_path_prompts": true,
	"autosave": {
		"after_delay": {
			"milliseconds": 1000
		}
	},
	"buffer_font_family": "JetBrainsMono Nerd Font Mono",
	"auto_indent_on_paste": true,
	"linked_edits": true,
	"show_whitespaces": "boundary",
	"show_edit_predictions": true,
	"line_ending": "prefer_lf",
	"ensure_final_newline_on_save": true,
	"soft_wrap": "editor_width",
	"tab_size": 2,
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"base_keymap": "VSCode",
	"agent_servers": {
		"opencode": {
			"default_config_options": {
				"model": "local/qwen3.5-9b",
				"mode": "plan"
			},
			"type": "registry"
		},
		"codex-acp": {
			"type": "registry"
		}
	},
	"ui_font_size": 14.0,
	"buffer_font_size": 13.5,
	"theme": {
		"mode": "dark",
		"light": "Ayu Light",
		"dark": "Tokyo Night Storm"
	},
	//----------- LSP config ------------
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": false,
				"config_path": "$HOME/.config/zed/biome.json"
			}
		},

		"vscode-css-language-server": {
			"settings": {
				"css": {
					"lint": {
						"unknownAtRules": "ignore"
					}
				}
			}
		}
	},

	// --------- Config for each languages ------------
	"languages": {
		"Astro": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"CSS": {
			"language_servers": [
				"tailwindcss-intellisense-css",
				"vscode-css-language-server",
				"!eslint",
				"..."
			],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"GraphQL": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"HTML": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSON": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSONC": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JavaScript": {
			"language_servers": ["!tsgo", "!eslint", "!typescript-language-server", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"Svelte": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TSX": {
			"inlay_hints": {},
			"show_whitespaces": "selection",
			"indent_guides": {
				"coloring": "indent_aware",
				"enabled": true
			},
			"hard_tabs": false,
			"tab_size": 2,
			"language_servers": ["!tsgo", "!eslint", "!typescript-language-server", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"language_servers": ["!tsgo", "!eslint", "!typescript-language-server", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"Vue.js": {
			"language_servers": ["!eslint", "..."],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		}
	}
}
